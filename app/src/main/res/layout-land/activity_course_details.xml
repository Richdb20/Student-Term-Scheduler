<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.CourseDetailsActivity">

    <ScrollView
        android:id="@id/scrollViewTwo"
        android:layout_width="408dp"
        android:layout_height="310dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.006"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Course:"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large" />

                <EditText
                    android:id="@+id/courseName"
                    android:layout_width="195dp"
                    android:layout_height="50dp"
                    android:autofillHints="Course Title"
                    android:hint="Course Name" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Start Date:"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large" />

                <EditText
                    android:id="@+id/courseStartDate"
                    android:layout_width="195dp"
                    android:layout_height="50dp"
                    android:autofillHints="Start Date"
                    android:hint="Start Date" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="End Date:"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large" />

                <EditText
                    android:id="@+id/courseEndDate"
                    android:layout_width="195dp"
                    android:layout_height="50dp"
                    android:autofillHints="End Date"
                    android:hint="End Date" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Note:"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large" />

                <EditText
                    android:id="@+id/courseNote"
                    android:layout_width="195dp"
                    android:layout_height="50dp"
                    android:autofillHints="Note"
                    android:hint="Note" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="172dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:text="Status:"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large" />

                <Spinner
                    android:id="@+id/courseStatus"
                    android:layout_width="195dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Instructor Details:"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large" />

                <EditText
                    android:id="@+id/instructorName"
                    android:layout_width="190dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="15dp"
                    android:autofillHints="Name"
                    android:hint="Name" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/instructorPhone"
                    android:layout_width="190dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="204dp"
                    android:autofillHints="Phone Number"
                    android:hint="Phone Number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/instructorEmail"
                    android:layout_width="190dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="204dp"
                    android:autofillHints="Email"
                    android:hint="Email" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:insetLeft="240dp"
                    android:insetRight="20dp"
                    android:onClick="saveCourseDetails"
                    android:text="@string/save"
                    android:textAlignment="center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/associatedAssessmentListView"
        android:layout_width="260dp"
        android:layout_height="225dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="56dp"
        android:background="@color/purple_200"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scrollViewTwo"
        app:layout_constraintTop_toBottomOf="@+id/button" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="207dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="109dp"
        android:text="Assessments"
        android:textAlignment="textStart"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/associatedAssessmentListView" />

    <Button
        android:id="@+id/button"
        android:layout_width="175dp"
        android:layout_height="45dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="142dp"
        android:clickable="true"
        android:onClick="addAssessmentToCourse"
        android:text="Add Assessment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

</androidx.constraintlayout.widget.ConstraintLayout>