<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.richardbrown_c196">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RichardBrownC196"
        tools:targetApi="31">
        <receiver
            android:name=".Activities.MyReceiver"
            android:enabled="true"
            android:exported="true"></receiver>

        <activity
            android:name=".Activities.AssessmentListActivity"
            android:exported="false"
            android:label="Assessment List"
            android:parentActivityName=".Activities.MainActivity" />
        <activity
            android:name=".Activities.AssessmentDetailsActivity"
            android:exported="false"
            android:label="Assessment Details"
            android:parentActivityName=".Activities.AssessmentListActivity" />
        <activity
            android:name=".Activities.CourseDetailsActivity"
            android:exported="false"
            android:label="Course Details"
            android:parentActivityName=".Activities.CourseListActivity" />
        <activity
            android:name=".Activities.CourseListActivity"
            android:exported="false"
            android:label="Course List"
            android:parentActivityName=".Activities.TermListActivity" />
        <activity
            android:name=".Activities.TermDetailsActivity"
            android:exported="false"
            android:label="Term Details"
            android:parentActivityName=".Activities.TermListActivity" />
        <activity
            android:name=".Activities.TermListActivity"
            android:exported="false"
            android:label="Term List"
            android:parentActivityName=".Activities.MainActivity" />
        <activity
            android:name=".Activities.MainActivity"
            android:exported="true"
            android:label="Term Scheduler App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>